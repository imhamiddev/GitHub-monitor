# ---------------------------------------------------------------------------
# GitHub Monitor — environment variables
# Copy this file to .env.local for local development and fill in real values.
# Never commit .env.local or any file with real secrets.
# ---------------------------------------------------------------------------

# --- App -------------------------------------------------------------------

# Public base URL of the deployed app (no trailing slash).
# Local dev: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database (Vercel Postgres / Neon) --------------------------------------

# Connection string from your Vercel Postgres (Neon) integration.
# Vercel Dashboard → Storage → your Postgres database → ".env.local" tab.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Better Auth -------------------------------------------------------------

# Same value as NEXT_PUBLIC_APP_URL — Better Auth's own base URL setting.
BETTER_AUTH_URL=http://localhost:3000

# Random 32+ byte secret used to sign sessions/cookies. Generate with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# --- Encryption --------------------------------------------------------------

# 32-byte, base64-encoded key used to encrypt cached GitHub installation
# tokens at rest (AES-256-GCM). Generate with:
#   openssl rand -base64 32
ENCRYPTION_KEY=

# --- GitHub App ---------------------------------------------------------------
# Create a GitHub App at https://github.com/settings/apps/new
# Required permissions: Repository → Contents (read), Metadata (read),
# Pull requests (read), Issues (read), Actions (read), Deployments (read).
# Subscribe to webhook events matching src/lib/github/events.ts.

# The app's numeric ID (GitHub App settings page, top of "General").
GITHUB_APP_ID=

# The app's URL-safe slug, e.g. "my-github-monitor" — used to build the
# installation URL: https://github.com/apps/<slug>/installations/new
GITHUB_APP_SLUG=

# OAuth client id/secret, from the GitHub App settings page.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# The app's private key (PEM). Generate one from the GitHub App settings
# page ("Generate a private key"), then paste its full contents here with
# literal "\n" for line breaks if setting this in a single-line env value
# (Vercel's dashboard UI accepts real newlines directly instead).
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"

# Webhook secret configured on the GitHub App's "Webhook" settings page.
# Generate with:
#   openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=

# --- Cron (Vercel Cron Jobs) --------------------------------------------------

# Shared secret Vercel sends as a Bearer token when invoking scheduled
# cron routes (see vercel.json). Vercel sets this automatically for
# projects using its Cron Jobs feature when CRON_SECRET is defined as
# a project environment variable — generate with:
#   openssl rand -hex 32
CRON_SECRET=
